# ============================================================
# Abdur Rahman Khan Portfolio — Server Environment Configuration
# ============================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
# Leave empty or set to mongodb://localhost:27017/abdur_rahman_portfolio
# In development, will seamlessly fall back to an embedded in-memory MongoDB if local daemon is not running
MONGODB_URI=mongodb://localhost:27017/abdur_rahman_portfolio

# JSON Web Token Secret (generate a secure random 32+ char string in production)
JWT_SECRET=super_secret_jwt_key_abdur_rahman_portfolio_dev_2026_change_in_prod
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins (Comma separated if multiple)
FRONTEND_URL=http://localhost:5173

# Public Site URL (for SEO, sitemap, canonical links)
PUBLIC_SITE_URL=http://localhost:5173

# Initial Administrator Credentials (used when running scripts/create-admin.js)
ADMIN_EMAIL=admin@abdurrahmankhan.com
ADMIN_PASSWORD=AdminSecurePass2026!

# SMTP Configuration for Contact Form Notifications (Optional for local dev)
# Leave unconfigured locally; emails will be logged safely to console and DB
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=abdurrahman94700@gmail.com
FROM_EMAIL=no-reply@abdurrahmankhan.com

